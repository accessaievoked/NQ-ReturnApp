generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify session storage (managed by @shopify/shopify-app-session-storage-prisma)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// One row per installed merchant. Every other table hangs off this.
model Shop {
  id              String    @id @default(cuid())
  domain          String    @unique // example.myshopify.com
  installedAt     DateTime  @default(now())
  uninstalledAt   DateTime?
  currency        String?
  productsSyncedAt DateTime?
  returnsSyncedAt DateTime?

  products Product[]
  returns  ReturnRequest[]
  events   ReturnEvent[]
  rules    AutomationRule[]
  runs     AutomationRun[]
}

model Product {
  id         String   @id @default(cuid())
  shopId     String
  shopifyId  String // gid://shopify/Product/123
  title      String
  handle     String?
  imageUrl   String?
  status     String? // ACTIVE | DRAFT | ARCHIVED
  vendor     String?
  productType String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop     Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants Variant[]
  items    ReturnItem[]

  @@unique([shopId, shopifyId])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  shopifyId String // gid://shopify/ProductVariant/123
  title     String?
  sku       String?
  price     Decimal? @db.Decimal(12, 2)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   ReturnItem[]

  @@unique([productId, shopifyId])
  @@index([shopifyId])
}

enum ReturnStatus {
  REQUESTED
  OPEN
  DECLINED
  CLOSED
  CANCELED
}

model ReturnRequest {
  id              String       @id @default(cuid())
  shopId          String
  shopifyId       String // gid://shopify/Return/123
  name            String // 1001-R1
  status          ReturnStatus @default(REQUESTED)
  orderShopifyId  String
  orderName       String? // #1001
  orderCreatedAt  DateTime?
  orderTotal      Decimal?     @db.Decimal(12, 2)
  currency        String?
  paymentMethod   String? // e.g. "razorpay, cash_on_delivery"
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  shippingAddress Json?
  totalQuantity   Int          @default(0)
  declineReason   String?
  declineNote     String?
  returnValue     Decimal      @default(0) @db.Decimal(12, 2) // sum(unitPrice * quantity) of the returned items
  autoHandled     Boolean      @default(false) // true when an automation rule approved/declined it
  refundedAmount  Decimal      @default(0) @db.Decimal(12, 2) // sum of Shopify refunds linked to this return (order currency)
  refundedAt      DateTime?
  exchangeUnits   Int          @default(0) // units the customer asked for in exchange (0 = plain return)
  exchangeDone    Int          @default(0) // exchange units already processed
  exchangeItems   Json? // replacement products the customer is taking: [{ id, title, variantTitle, sku, imageUrl, quantity, processedQuantity, unitPrice }]
  shipmentStatus  String? // AWAITING_SHIPMENT | IN_TRANSIT | RECEIVED | CANCELED (from reverse fulfillment orders)
  awb             String? // return-shipment tracking number
  carrier         String?
  requestedAt     DateTime
  closedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  shop   Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items  ReturnItem[]
  events ReturnEvent[]
  runs   AutomationRun[]

  @@unique([shopId, shopifyId])
  @@index([shopId, status])
  @@index([shopId, requestedAt])
  @@index([shopId, customerEmail])
}

model ReturnItem {
  id                 String   @id @default(cuid())
  returnId           String
  shopifyId          String // gid://shopify/ReturnLineItem/123
  productId          String? // our Product.id, null if product not synced/deleted
  variantId          String?
  title              String
  variantTitle       String?
  sku                String?
  imageUrl           String?
  quantity           Int
  unitPrice          Decimal? @db.Decimal(12, 2)
  reason             String? // Shopify ReturnReason enum e.g. SIZE_TOO_SMALL
  reasonNote         String?
  customerNote       String?
  customerImages     String[] @default([]) // photos uploaded by the customer (portal; Shopify native returns have none)

  return  ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant Variant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([returnId, shopifyId])
  @@index([productId])
  @@index([reason])
}

enum EventKind {
  WEBHOOK // status change received from Shopify
  ACTION // merchant action taken in this app
  NOTE // merchant note
}

// Activity timeline shown on a return.
model ReturnEvent {
  id        String    @id @default(cuid())
  shopId    String
  returnId  String
  kind      EventKind
  title     String
  detail    String?
  actor     String? // merchant email / "Shopify"
  createdAt DateTime  @default(now())

  shop   Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId, createdAt])
}

enum RuleAction {
  APPROVE
  DECLINE
}

// Merchant-defined automation: when ALL conditions match a new return request, take `action`.
// Rules are evaluated in ascending `priority`; the first match wins.
model AutomationRule {
  id          String     @id @default(cuid())
  shopId      String
  name        String
  enabled     Boolean    @default(true)
  priority    Int        @default(100)
  action      RuleAction
  declineNote String? // shown to the customer when action = DECLINE
  conditions  Json // see RuleConditions in services/automation.server.ts
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  shop Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([shopId, enabled, priority])
}

// Audit log: one row each time a rule fired (powers the Automations KPI and "hours saved").
model AutomationRun {
  id        String     @id @default(cuid())
  shopId    String
  ruleId    String?
  returnId  String
  action    RuleAction
  ok        Boolean    @default(true)
  error     String?
  createdAt DateTime   @default(now())

  shop   Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rule   AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  return ReturnRequest   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}
