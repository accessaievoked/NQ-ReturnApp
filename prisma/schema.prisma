generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify session storage (managed by @shopify/shopify-app-session-storage-prisma)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// One row per installed merchant. Every other table hangs off this.
model Shop {
  id              String    @id @default(cuid())
  domain          String    @unique // example.myshopify.com
  installedAt     DateTime  @default(now())
  uninstalledAt   DateTime?
  currency        String?
  productsSyncedAt DateTime?
  returnsSyncedAt DateTime?

  products Product[]
  returns  ReturnRequest[]
  events   ReturnEvent[]
  rules    AutomationRule[]
  runs     AutomationRun[]
  shiprocket ShiprocketConnection?
  portalSettings  PortalSettings?
  exchangeRequests ExchangeRequest[]
  portalUploads    PortalUpload[]
  emailSettings    EmailSettings?
  emailTemplates   EmailTemplate[]
  emailLogs        EmailLog[]
  returnFormTheme  ReturnFormTheme?
}

model Product {
  id         String   @id @default(cuid())
  shopId     String
  shopifyId  String // gid://shopify/Product/123
  title      String
  handle     String?
  imageUrl   String?
  status     String? // ACTIVE | DRAFT | ARCHIVED
  vendor     String?
  productType String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop     Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants Variant[]
  items    ReturnItem[]

  @@unique([shopId, shopifyId])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  shopifyId String // gid://shopify/ProductVariant/123
  title     String?
  sku       String?
  price     Decimal? @db.Decimal(12, 2)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   ReturnItem[]

  @@unique([productId, shopifyId])
  @@index([shopifyId])
}

enum ReturnStatus {
  REQUESTED
  OPEN
  DECLINED
  CLOSED
  CANCELED
}

model ReturnRequest {
  id              String       @id @default(cuid())
  shopId          String
  shopifyId       String // gid://shopify/Return/123
  name            String // 1001-R1
  status          ReturnStatus @default(REQUESTED)
  orderShopifyId  String
  orderName       String? // #1001
  orderCreatedAt  DateTime?
  orderTotal      Decimal?     @db.Decimal(12, 2)
  currency        String?
  paymentMethod   String? // e.g. "razorpay, cash_on_delivery"
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  shippingAddress Json?
  totalQuantity   Int          @default(0)
  declineReason   String?
  declineNote     String?
  returnValue     Decimal      @default(0) @db.Decimal(12, 2) // sum(unitPrice * quantity) of the returned items
  autoHandled     Boolean      @default(false) // true when an automation rule approved/declined it
  refundedAmount  Decimal      @default(0) @db.Decimal(12, 2) // sum of Shopify refunds linked to this return (order currency)
  refundedAt      DateTime?
  exchangeUnits   Int          @default(0) // units the customer asked for in exchange (0 = plain return)
  exchangeDone    Int          @default(0) // exchange units already processed
  exchangeItems   Json? // replacement products the customer is taking: [{ id, title, variantTitle, sku, imageUrl, quantity, processedQuantity, unitPrice }]
  shipmentStatus  String? // AWAITING_SHIPMENT | IN_TRANSIT | RECEIVED | CANCELED (from reverse fulfillment orders)
  awb             String? // return-shipment tracking number
  carrier         String?
  srOrderId         String? // Shiprocket order id of the reverse shipment we booked
  srShipmentId      String?
  carrierStatus     String? // latest courier status text from Shiprocket, e.g. "PICKED UP"
  pickupScheduledAt DateTime?
  pickupError       String? // why booking the pickup failed (shown to the merchant, cleared on success)
  trackingScans     Json? // latest courier scans: [{ date, status, activity, location }]
  requestedAt     DateTime
  closedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  shop   Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items  ReturnItem[]
  events ReturnEvent[]
  runs   AutomationRun[]

  @@unique([shopId, shopifyId])
  @@index([shopId, status])
  @@index([shopId, requestedAt])
  @@index([shopId, customerEmail])
  @@index([awb])
}

model ReturnItem {
  id                 String   @id @default(cuid())
  returnId           String
  shopifyId          String // gid://shopify/ReturnLineItem/123
  productId          String? // our Product.id, null if product not synced/deleted
  variantId          String?
  title              String
  variantTitle       String?
  sku                String?
  imageUrl           String?
  quantity           Int
  unitPrice          Decimal? @db.Decimal(12, 2)
  reason             String? // Shopify ReturnReason enum e.g. SIZE_TOO_SMALL
  reasonNote         String?
  customerNote       String?
  customerImages     String[] @default([]) // photos uploaded by the customer (portal; Shopify native returns have none)

  return  ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant Variant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([returnId, shopifyId])
  @@index([productId])
  @@index([reason])
}

enum EventKind {
  WEBHOOK // status change received from Shopify
  ACTION // merchant action taken in this app
  NOTE // merchant note
}

// Activity timeline shown on a return.
model ReturnEvent {
  id        String    @id @default(cuid())
  shopId    String
  returnId  String
  kind      EventKind
  title     String
  detail    String?
  actor     String? // merchant email / "Shopify"
  createdAt DateTime  @default(now())

  shop   Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  return ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId, createdAt])
}

enum RuleAction {
  APPROVE
  DECLINE
}

// Merchant-defined automation: when ALL conditions match a new return request, take `action`.
// Rules are evaluated in ascending `priority`; the first match wins.
model AutomationRule {
  id          String     @id @default(cuid())
  shopId      String
  name        String
  enabled     Boolean    @default(true)
  priority    Int        @default(100)
  action      RuleAction
  declineNote String? // shown to the customer when action = DECLINE
  conditions  Json // see RuleConditions in services/automation.server.ts
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  shop Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  runs AutomationRun[]

  @@index([shopId, enabled, priority])
}

// Audit log: one row each time a rule fired (powers the Automations KPI and "hours saved").
model AutomationRun {
  id        String     @id @default(cuid())
  shopId    String
  ruleId    String?
  returnId  String
  action    RuleAction
  ok        Boolean    @default(true)
  error     String?
  createdAt DateTime   @default(now())

  shop   Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  rule   AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  return ReturnRequest   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

// One Shiprocket account per shop. Credentials are stored encrypted (see services/crypto.server.ts).
model ShiprocketConnection {
  id             String    @id @default(cuid())
  shopId         String    @unique
  publicId       String    @unique // identifies the shop in the webhook URL
  webhookSecret  String // Shiprocket sends this back as the x-api-key header
  email          String? // the Shiprocket *API user* email
  passwordEnc    String?
  tokenEnc       String?
  tokenExpiresAt DateTime?
  connected      Boolean   @default(false)

  // where returned parcels are delivered (the merchant's warehouse)
  whName     String?
  whAddress  String?
  whAddress2 String?
  whCity     String?
  whState    String?
  whPincode  String?
  whPhone    String?
  whEmail    String?
  whCountry  String  @default("India")

  // default parcel used for every reverse pickup
  parcelLength  Float @default(10)
  parcelBreadth Float @default(10)
  parcelHeight  Float @default(10)
  parcelWeight  Float @default(0.5)

  // what runs without a click once a return is approved
  autoPickup  Boolean @default(false) // book the reverse pickup on approval
  autoReceive Boolean @default(true) // mark the return received when the courier delivers it
  autoRefund  Boolean @default(false) // refund prepaid returns / complete exchanges once received

  lastWebhookAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// What the customer-facing return/exchange form allows. Enforced on the server, never trusted from the browser.
model PortalSettings {
  id               String  @id @default(cuid())
  shopId           String  @unique
  enabled          Boolean @default(true)
  allowReturns     Boolean @default(true)
  allowExchanges   Boolean @default(true)
  exchangeMode     String  @default("VARIANT") // VARIANT = other sizes/colours of the same product, ANY = any product
  windowDays       Int     @default(30) // days after delivery
  nonReturnableTag String  @default("final-sale") // products with this tag can't be returned
  requireNote      Boolean @default(false)
  notice           String? // optional message at the top of the form
  photoMode        String  @default("OPTIONAL") // OFF | OPTIONAL | REQUIRED — customer photos of each returned item

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

enum PortalRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// An exchange asked for through the form. Held here until the merchant approves it, because Shopify can only create an
// exchange as an already-approved return. On approval it becomes a real Shopify return (see portal.server.ts).
model ExchangeRequest {
  id               String              @id @default(cuid())
  shopId           String
  code             String // customer-facing reference, e.g. EX-7K2QX
  orderGid         String
  orderName        String
  customerName     String?
  customerEmail    String
  status           PortalRequestStatus @default(PENDING)
  items            Json // returning: [{ fulfillmentLineItemId, title, variantTitle, imageUrl, quantity, unitPrice, reasonId, reasonName, note }]
  replacements     Json // taking:    [{ forKey, variantId, title, variantTitle, imageUrl, quantity, unitPrice }]
  returnValue      Decimal             @db.Decimal(12, 2)
  replacementValue Decimal             @db.Decimal(12, 2)
  currency         String?
  flags            Json? // risk hints for the merchant, e.g. ["3 returns in 90 days"]
  declineNote      String?
  returnId         String? // local ReturnRequest created on approval
  createdAt        DateTime            @default(now())
  decidedAt        DateTime?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, code])
  @@index([shopId, status, createdAt])
}

// A photo a customer attached on the return form. Stored in the database (resized in the browser first, so each is a few
// hundred KB) and served through a signed URL (see routes/media.$id.tsx). Unclaimed uploads are deleted after a day.
model PortalUpload {
  id        String   @id @default(cuid())
  shopId    String
  mime      String
  size      Int
  data      Bytes
  claimed   Boolean  @default(false)
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, claimed, createdAt])
}

// Look and sender details shared by every customer email of a shop.
model EmailSettings {
  id         String  @id @default(cuid())
  shopId     String  @unique
  fromName   String? // display name; the address itself is the SMTP account
  replyTo    String?
  brandColor String  @default("#3b3fe0")
  logoUrl    String?
  footer     String?
  portalUrl  String? // link to the page holding the return form, offered in emails as {{form_url}}

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// A merchant's edit of one email. No row = the built-in default (lib/email-defaults.ts).
model EmailTemplate {
  id        String   @id @default(cuid())
  shopId    String
  event     String // e.g. exchange_approved
  enabled   Boolean  @default(true)
  subject   String
  body      String // HTML with {{variables}}
  wrap      Boolean  @default(true) // wrap in the branded header/footer layout
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, event])
}

// Every email we tried to send. `dedupeKey` stops the same event emailing a customer twice (webhooks re-deliver).
model EmailLog {
  id        String   @id @default(cuid())
  shopId    String
  event     String
  toEmail   String
  subject   String
  status    String // SENT | FAILED | LOGGED (SMTP not configured)
  error     String?
  dedupeKey String?
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, dedupeKey])
  @@index([shopId, createdAt])
}

// The customer-facing return/exchange form of ONE store: its markup, its CSS and a few selectable style options.
// Same idea as Judge.me's ReviewFormTheme. No row = the built-in defaults in lib/return-form-template.ts.
//  - `html` uses {{tokens}} and <!--BLOCK-->…<!--/BLOCK--> markers (documented in that file and in the editor); the form's
//    behaviour is wired to fixed data-er-* attributes, so merchants can restyle and rearrange freely.
//  - `style` holds the simple options (colours, radius, font size, button shape…) the merchant sets without touching code.
model ReturnFormTheme {
  id        String   @id @default(cuid())
  shopId    String   @unique
  html      String
  css       String
  style     Json?
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}
